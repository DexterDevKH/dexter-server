{
	"name": "anisette-v3-server",
	"description": "macOS ADI Gateway and Relay for SideStore and AltStore",
	"authors": [
		"Dadoum",
		"Dexter"
	],
	"dependencies": {
		"slf4d": "~>2.1.1",
		"vibe-d:web": "~>0.9.8",
		"vibe-d:http": "~>0.9.8"
	},
	"configurations": [
		{
			"name": "default",
			"targetType": "executable"
		},
		{
			"name": "static",
			"targetType": "executable",
			"lflags-linux-ldc": [
				"-lz"
			],
			"dflags-ldc": [
				"--link-defaultlib-shared=false"
			],
			"dflags-gdc": [
				"-defaultlib=:libgphobos.a"
			]
		}
	]
}
